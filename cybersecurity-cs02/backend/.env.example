# SecureMart Backend - Environment Variables (EXAMPLE)
# ============================================================================
# LABORATORY USE ONLY. Never commit a real .env file.
# Copy this file to .env and adjust values for your machine.
# ============================================================================

# HTTP port the Express API listens on
PORT=5000

# --- MySQL connection -------------------------------------------------------
# NOTE: this laboratory uses a user-space MySQL instance on port 3307 because
# the host's system MySQL credentials were unavailable and AppArmor confined
# /usr/sbin/mysqld to /var/lib/mysql. A stock install typically uses 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=securemart_db
DB_USER=your_user
DB_PASSWORD=your_password

# --- Authentication ---------------------------------------------------------
# Replace with a long random string in any shared environment.
JWT_SECRET=replace_with_local_secret
JWT_EXPIRES_IN=1h

# --- CORS -------------------------------------------------------------------
# Allowed origin = the Vite dev server
CLIENT_URL=http://localhost:5173

# development | production | test
NODE_ENV=development
